# Gmail SMTP example. Use a Gmail App Password, not your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Portfolio Contact <your-email@gmail.com>"
CONTACT_TO_EMAIL=your-inbox@example.com

# Public base URL of the deployed site, no trailing slash. Used for robots.txt, sitemap.xml and metadataBase.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
